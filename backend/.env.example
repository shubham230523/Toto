# Server Configuration
PORT=3000

# Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/toto
STORAGE_URL=http://localhost:3000/uploads
STORAGE_PATH=./uploads

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
IMAGE_PROVIDER_URL=https://api.imageprovider.example.com
IMAGE_PROVIDER_API_KEY=your_image_provider_api_key_here
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# TTS Provider
TTS_API_KEY=your_tts_api_key_here
TTS_URL=https://api.ttsprovider.example.com
TTS_MODEL=tts-1
